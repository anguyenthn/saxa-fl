import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, r2_score
import matplotlib.pyplot as plt

file_path = "data/NFLpbp_Schedule_Merged.csv"

# Load CSV
df = pd.read_csv(file_path, low_memory=False)

# Extract year from game_id
df['year'] = df['game_id'].str.split('_').str[0].astype(int)
df = df[df['year'] >= 2021].copy()

# Columns to keep
cols_to_keep = [
    "home_team_x", "away_team_x", "week_x", "posteam", "side_of_field", "season_x",
    "penalty_team", "penalty_yards", "drive_time_of_possession", "away_score_x",
    "home_score_x", "roof_x", "surface_x", "temp_x", "wind_x", "away_rest",
    "home_rest", "is_thursday", "is_away_game", "is_international", "passing_yards",
    "total_home_raw_yac_epa", "epa", "wpa", "sack", "third_down_converted",
    "total_away_raw_yac_epa", "score_differential", "air_yards", "yards_after_catch",
    "yards_gained"
]

df = df[cols_to_keep].copy()

# Map NFL teams
team_mapping = {
    'ARI': 1, 'ATL': 2, 'BAL': 3, 'BUF': 4, 'CAR': 5, 'CHI': 6, 'CIN': 7,
    'CLE': 8, 'DAL': 9, 'DEN': 10, 'DET': 11, 'GB': 12, 'HOU': 13, 'IND': 14,
    'JAX': 15, 'KC': 16, 'LV': 17, 'LAC': 18, 'LAR': 19, 'MIA': 20, 'MIN': 21,
    'NE': 22, 'NO': 23, 'NYG': 24, 'NYJ': 25, 'PHI': 26, 'PIT': 27, 'SEA': 28,
    'SF': 29, 'TB': 30, 'TEN': 31, 'WAS': 32
}

for col in ["home_team_x", "away_team_x", "posteam", "penalty_team"]:
    df[col] = df[col].map(team_mapping).astype("category")

# Convert roof/surface to category
df["roof_x"] = df["roof_x"].astype("category")
df["surface_x"] = df["surface_x"].astype("category")

# Convert side_of_field to binary
df["side_of_field_binary"] = (df["side_of_field"] == "home").astype(int)
df.drop(columns=["side_of_field"], inplace=True)

# Convert drive_time_of_possession to seconds
df["drive_time_of_possession_seconds"] = pd.to_timedelta("00:" + df["drive_time_of_possession"]).dt.total_seconds()
df.drop(columns=["drive_time_of_possession"], inplace=True)

# Drop rows with missing values
df = df.dropna().reset_index(drop=True)

# Features and target
X = df.drop("score_differential", axis=1)
y = df["score_differential"]

# One-hot encode categorical columns
categorical_cols = ["home_team_x", "away_team_x", "posteam", "penalty_team", "roof_x", "surface_x"]
X = pd.get_dummies(X, columns=categorical_cols, drop_first=True)

# Train/test split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.15, random_state=42)

# Train Random Forest Regressor
model = RandomForestRegressor(n_estimators=100, random_state=50)
model.fit(X_train, y_train)

# Predict
y_pred = model.predict(X_test)

# Evaluation
print("R2 Score:", r2_score(y_test, y_pred))
print("MSE:", mean_squared_error(y_test, y_pred))

# Feature importance
feature_importance_df = pd.DataFrame({
    'feature': X.columns,
    'importance': model.feature_importances_
}).sort_values(by='importance', ascending=False)

print(feature_importance_df.head(20))

# Plot
plt.figure(figsize=(10, 8))
feature_importance_df.sort_values("importance").plot(
    kind="barh", x="feature", y="importance", legend=False, figsize=(12, 10)
)
plt.title("Random Forest Feature Importance")
plt.xlabel("Importance")
plt.ylabel("Feature")
plt.tight_layout()
plt.show()
