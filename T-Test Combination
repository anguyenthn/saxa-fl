import pandas as pd
import plotly.express as px
from scipy.stats import ttest_ind

# This code automates the t-test function Amy created so we can look at a few of the stats that 
# Kesh came up for positional metrics. I created scatter plots based on the plots that are 
# significant results for both player level (Kesh's data) and game level (Amy's data)

# Load data
team_week = pd.read_csv('data/team_week_aggregate.csv')
merged_player_data = pd.read_csv('data/df_merged_final.csv')

significant_results = []

# Position Stats Found in Kesh's RF Model Code 
pass_stats = ["attempts", "completions", "passing_yards", "passing_tds", "interceptions",
              "sacks", "sack_yards", "sack_fumbles", "sack_fumbles_lost",
              "passing_air_yards", "passing_yards_after_catch",
              "passing_first_downs", "passing_2pt_conversions"]

rush_stats = ["carries", "rushing_yards", "rushing_tds",
              "rushing_fumbles", "rushing_fumbles_lost", "rushing_first_downs"]

rec_stats = ['receptions', 'targets', 'receiving_yards', 'receiving_tds', 'receiving_fumbles',
             'receiving_fumbles_lost', 'receiving_air_yards', 'receiving_yards_after_catch', 
             'receiving_first_downs', 'receiving_2pt_conversions', 'racr', 'target_share', 
             'air_yards_share', 'wopr']

all_metrics = pass_stats + rush_stats + rec_stats

# Flag column
flag_columns= ['isaway', 'is_thursday','is_international']  


# T-Test Function (wanted to only look at significant ones in the df) 
def run_t_tests(df_name, df, flag_cols, metrics, label_prefix=''):
    for flag in flag_cols:
        for metric in metrics:
            if metric in df.columns:
                group1 = df.loc[df[flag] == 1, metric].dropna()
                group0 = df.loc[df[flag] == 0, metric].dropna()

                if len(group1) > 1 and len(group0) > 1:  # Ensure enough data
                    t_stat, p_val = ttest_ind(group1, group0, equal_var=False)
                    print(f"{label_prefix}{flag} – {metric}")
                    print(f"  Mean (flag=1): {group1.mean():.2f}")
                    print(f"  Mean (flag=0): {group0.mean():.2f}")
                    print(f"  T-stat: {t_stat:.3f}, P-value: {p_val:.4f}\n")

                    if p_val < 0.05: # creates a dataframe to look at the significant values
                        significant_results.append({
                            'dataset': df_name,
                            'flag': flag,
                            'metric': metric,
                            'mean_flag_1': group1.mean(),
                            'mean_flag_0': group0.mean(),
                            't_stat': t_stat,
                            'p_value': p_val
                        })

# Run tests on both datasets
print("===== TEAM-WEEK DATASET =====")
run_t_tests('Game Level Data',team_week, flag_columns, all_metrics, label_prefix='TeamWeek: ')

print("\n===== PLAYER-LEVEL DATASET =====")
run_t_tests('Player Level Data',merged_player_data, flag_columns, all_metrics, label_prefix='PlayerData: ')


# Convert significant results to DataFrame
signif_df = pd.DataFrame(significant_results)

# Display or save
print("\n===== SIGNIFICANT RESULTS (p < 0.05) =====")
print(signif_df)


